# ── Secrets / environment ──
.env
.env.local
.env.*.local

# js/config.js holds the real Supabase URL/key and must never be
# committed. js/config.example.js is the template that IS tracked —
# copy it to js/config.js locally and fill in the real values (see
# README.md → "Configuration"). This line intentionally does not use
# a wildcard like config*.js, so config.example.js stays tracked.
js/config.js

# ── OS files ──
.DS_Store
Thumbs.db
desktop.ini

# ── Editor / IDE ──
.vscode/
.idea/
*.swp
*.swo
*~

# ── Logs ──
*.log
npm-debug.log*

# ── Dependency directories (only relevant if tooling is added later) ──
node_modules/

# ── Local scratch / exports ──
*.tmp
/exports/
/downloads/

# ── Company-sensitive raw data ──
# Any raw Excel exports or CSV dumps of actual sales data should never
# be committed to this repo. Keep them entirely outside the project
# folder, or in an explicitly-approved private data directory that is
# excluded here.
*.xlsx
*.xls
!/**/sample-data/**/*.xlsx
